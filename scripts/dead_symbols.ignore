# Exported functions with no production caller that are deliberately kept.
#
# Format: symbol  # reason
# An entry without a reason after "#" fails the check, and an entry whose symbol
# has since gained a caller fails it too — the list cannot silently rot.
#
# Every keep here should also appear in docs/legacy-llm/decisions.md.

log_unsubscribe               # subscribe/unsubscribe is a coherent pair; see SRC-D01
subtitle_overlay_clear_sof    # HAL primitives for frame-sync deferred in ARCH-03 F17a; see SRC-D04
subtitle_overlay_read_control # HAL primitives for frame-sync deferred in ARCH-03 F17a; see SRC-D04
subtitle_overlay_wait_sof     # HAL primitives for frame-sync deferred in ARCH-03 F17a; see SRC-D04
stt_ws_client_cleanup         # self-documented legacy shim; ARCH-05 replaces it
trace_flush                   # tracer checkpoint API; only tests force a flush, see SRC-D09
trace_get_stats               # tracer self-reporting; read by tests and diagnostics, see SRC-D09
